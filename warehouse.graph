# ---------------------------------------------------------------------
# Sample problem: a robot crossing a warehouse floor in R^2.
# Two chemical drums are bad states. Three routes exist: a short one that
# passes between the drums, a medium one, and a long outer aisle.
#
# Format
#   dim     <d>
#   state   <id> <label> <x1> ... <xd>          ids consecutive from 0
#   bad     <id> [<id> ...]
#   edge    <from> <to> <cost> [safety] [reliability] [available]
#   start   <id>
#   goal    <id>
#   weights <lambda> <dSafe> <mu> <nu> <alpha> <beta> <gamma> <delta>
# ---------------------------------------------------------------------

dim 2

state 0  dock      0.0   0.0
state 1  aisleA    3.0   0.5
state 2  aisleB    6.0   0.5
state 3  aisleC    3.0   3.0
state 4  aisleD    6.0   3.0
state 5  outerE    3.0   6.5
state 6  outerF    6.0   6.5
state 7  bay       9.0   0.0
state 8  drum1     4.5   0.0
state 9  drum2     4.5   1.6

bad 8 9

# short route, squeezes between the drums
edge 0 1 2.0 0.9 0.99
edge 1 2 2.0 0.9 0.98
edge 2 7 2.0 0.9 0.99

# medium route
edge 0 3 3.2 1.0 0.98
edge 3 4 3.0 1.0 0.98
edge 4 7 3.2 1.0 0.98

# long outer aisle, well clear of the drums
edge 0 5 5.0 1.0 0.97
edge 5 6 3.0 1.0 0.97
edge 6 7 5.0 1.0 0.97

# cross-links between the inner routes
edge 1 3 2.5 1.0 0.98
edge 3 5 3.5 1.0 0.97
edge 2 4 2.5 1.0 0.98
edge 4 6 3.5 1.0 0.97

start 0
goal 7

# lambda dSafe mu nu   alpha beta gamma delta
weights 4.0 2.5 0.5 0.5   100.0 1.0 10.0 1.0
